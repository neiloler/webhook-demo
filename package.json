{
  "name": "webhook-demo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "test-harness"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "build:backend": "npm run build -w backend",
    "start:backend": "npm run start -w backend",
    "typecheck:backend": "npm run typecheck -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build:frontend": "npm run build -w frontend",
    "start:frontend": "npm run start -w frontend",
    "typecheck:frontend": "npm run typecheck -w frontend",
    "dev:harness": "npm run dev -w test-harness --",
    "build:harness": "npm run build -w test-harness",
    "start:harness": "npm run start -w test-harness --",
    "typecheck:harness": "npm run typecheck -w test-harness",
    "auth:migrate": "npm run auth:migrate -w backend"
  }
}
